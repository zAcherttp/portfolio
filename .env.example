# Optional: override the combined accounts from data/profile.ts
# GITHUB_USERNAMES=zAcherttp,Phat-Learneris
# Optional: legacy primary-account override; blank uses the default personal account
GITHUB_USERNAME=
# Optional: override the public contributions API base URL
GITHUB_CONTRIBUTIONS_API_URL=

# Required in production: distributed rate limiting for public API routes
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: canonical site URL for local or non-Vercel deployments
# Vercel deployments fall back to VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Optional: raises the GitHub API rate limit for scripts/update-projects.js
GITHUB_TOKEN=

# Optional: points Playwright at an already-running development server
PLAYWRIGHT_BASE_URL=
